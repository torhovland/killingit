    }
  ]
},
  "diet": { "goal": "string", "goalProvided": false, "goalWeightKg": 0, "goalBodyFatPercent": 0, "goalDate": "YYYY-MM-DD", "goalMissReason": "string", "assessment": "string" },
  "bodyMetrics": [{ "date": "YYYY-MM-DD", "weightKg": 0, "bodyFatPercent": 0 }],
