# Example for .env.auth0.local — copy to .env.auth0.local and fill in real values.
#
# This file feeds scripts/auth0-mcp.sh, which mints a Management API token for
# our Auth0 tenant on every launch. It is gitignored; do not commit real values.
#
# 1. In the Auth0 dashboard (dev-5qhhcjppmcpsomq0.us.auth0.com), create a
#    Machine-to-Machine application and grant the Auth0 Management API
#    (https://dev-5qhhcjppmcpsomq0.us.auth0.com/api/v2/) the scopes you need,
#    e.g.:
#      read:clients create:clients update:clients
#      read:resource_servers create:resource_servers update:resource_servers
#      read:actions read:logs read:forms read:client_credentials
# 2. Fill the two values below.

AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=

# Optional override of the tenant domain (defaults to the dev tenant):
# AUTH0_DOMAIN=dev-5qhhcjppmcpsomq0.us.auth0.com