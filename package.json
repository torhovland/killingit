{
  "name": "killingit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run db:migrate && bun run --parallel dev:web dev:api dev:garmin",
    "dev:web": "bun run --filter @killingit/web dev",
    "dev:api": "bun run --filter @killingit/api dev",
    "dev:garmin": "scripts/dev-garmin.sh",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "bun run --filter '*' test",
    "outdated": "bun run scripts/check-outdated.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @killingit/api db:generate",
    "db:migrate": "bun run --filter @killingit/api db:migrate",
    "benchmark:llm": "bun run --filter @killingit/api benchmark:llm"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
