{
  "name": "killingit",
  "private": true,
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "bun run db:migrate && bun run --parallel dev:web dev:api dev:garmin",
    "dev:web": "bun run --filter @killingit/web dev",
    "dev:api": "bun run --filter @killingit/api dev",
    "dev:garmin": "scripts/dev-garmin.sh",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "bun test scripts && bun run --filter '*' test",
    "test:coverage": "bun run scripts/coverage.ts",
    "test:integration": "bun run --filter @killingit/api test:integration",
    "test:e2e": "playwright test --config apps/web/playwright.config.ts",
    "check:garmin": "scripts/check-garmin.sh",
    "check:signoff": "bun run scripts/check-signoff.ts",
    "check:unused": "knip --production --include files,exports --no-progress",
    "outdated": "bun run scripts/check-outdated.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @killingit/api db:generate",
    "db:migrate": "bun run --filter @killingit/api db:migrate",
    "benchmark:llm": "bun run tools/benchmark/src/cli.ts",
    "benchmark:prompts": "bun run tools/benchmark/src/cli.ts prompts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@killingit/benchmark": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
