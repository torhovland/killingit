# Copy to .env and fill in real values. Do not commit .env.

# PostgreSQL connection string for the API / Drizzle.
# Local (docker compose): postgres://killingit:killingit@localhost:5432/killingit
# Deployed: the Neon pooled connection string (runtime). See
# DATABASE_URL_UNPOOLED for migrations.
DATABASE_URL=postgres://killingit:killingit@localhost:5432/killingit

# Direct (unpooled) Neon connection string, used only by `db:migrate` /
# drizzle-kit. Set to the Neon URL without `-pooler` in the hostname.
# Falls back to DATABASE_URL (fine for local dev against docker compose).
DATABASE_URL_UNPOOLED=postgres://killingit:killingit@localhost:5432/killingit

# Port the API server listens on. Cloud Run sets PORT=8080 automatically.
PORT=3001

# Comma-separated list of allowed CORS origins for the web app.
CORS_ORIGIN=http://localhost:5173

# Absolute API origin used by the web app build (empty = relative /api for the
# local Vite dev proxy). Set per environment when deploying to Cloudflare Pages.
VITE_API_URL=

# Browser DSN for the React (Vite) app, injected at build time. When unset,
# Sentry is disabled in the frontend. Points at the `killingit-web` project.
# Format: https://<public-key>@o<org>.ingest.<region>.sentry.io/<project-id>
VITE_SENTRY_DSN=

# Sentry DSN for the Bun/Hono API, read at runtime. When unset, Sentry is
# disabled (local dev, tests). Points at the `killingit-api` project. Set in
# the deploy pipeline (TEST_SENTRY_DSN / PROD_SENTRY_DSN).
# Format: https://<public-key>@o<org>.ingest.<region>.sentry.io/<project-id>
SENTRY_DSN=

# Optional Sentry release identifier (e.g. the git SHA). Leave empty to unset.
SENTRY_RELEASE=

# Sentry auth token (org-scoped) for source-map upload from the web build, plus
# the org slug and project slug. The web build uploads source maps only when all
# three are set. Do not commit a real token here.
#
# The API's source-map upload happens in CI (the Docker build), driven by the
# SENTRY_AUTH_TOKEN BuildKit secret and SENTRY_ORG / SENTRY_PROJECT=killingit-api
# build args in .github/workflows/deploy.yml — not by these local env vars.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=killing-it
SENTRY_PROJECT=killingit-web

# Auth0 — web (SPA). These are non-secret (the client ID is public by design
# for a SPA) but must carry the VITE_ prefix so Vite exposes them to client
# code via import.meta.env. See ADR 0002 and apps/web/.env.local.
VITE_AUTH0_DOMAIN=dev-5qhhcjppmcpsomq0.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.killingit.hovland.co

# Auth0 — API (token verification). Read server-side from process.env, so no
# VITE_ prefix. The audience must match VITE_AUTH0_AUDIENCE above; the issuer
# is the tenant domain with a trailing slash.
AUTH0_ISSUER=https://dev-5qhhcjppmcpsomq0.us.auth0.com/
AUTH0_AUDIENCE=https://api.killingit.hovland.co

# Garmin integration (ADR 0003 amendment). See docs/specs/garmin-activity-integration.md.
# Secret used to derive the AES-256-GCM key that encrypts the operator's Garmin
# username/password at rest. Any passphrase works (hashed to a 32-byte key).
GARMIN_CREDENTIALS_KEY=

# Base URL of the Python Garmin sidecar service (services/garmin). Defaults to
# http://localhost:8000 for local dev.
GARMIN_SIDECAR_URL=http://localhost:8000

# Optional directory where the sidecar caches Garmin session tokens between
# calls (avoids re-logging in and triggering Garmin's 429 rate limit). Defaults
# to a private 0700 temp dir when unset.
# GARMIN_TOKENSTORE_DIR=

# OpenRouter LLM integration (ADR 0004). Secret used to derive the AES-256-GCM
# key that encrypts the operator's OpenRouter API token at rest. Any passphrase
# works, but keep it separate from GARMIN_CREDENTIALS_KEY so either can rotate
# independently. When unset, saving an OpenRouter key fails with a clear 503.
LLM_CREDENTIALS_KEY=

# Optional OpenRouter API base URL override. Defaults to
# https://openrouter.ai/api/v1; useful for a proxy or in tests.
# OPENROUTER_API_URL=
